# GlobalTrade S.A. — variables de entorno (runtime unificado)

DUCKDB_PATH=db/globtrade.duckdb
PARQUET_PATH=data/ventas.parquet

# Panel admin (opcional PocketBase)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
POCKETBASE_SYNC_ON_STARTUP=false

# Portal B2B (requerido para arranque local)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# IA (Groq u OpenAI-compatible) — NO commitear la key real
# IA (también configurable desde Admin → Configuración → Inteligencia artificial)
IA_API_KEY=
IA_BASE_URL=https://api.groq.com/openai/v1
IA_MODEL=llama-3.3-70b-versatile

# ClickHouse (almacén analítico)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=globtrade
CLICKHOUSE_DB=globtrade_dwh

# DuckDB readonly durante ventana ETL
DUCKDB_READONLY=false

# ETL con Docker (Airflow/scripts delegan al admin en :8000)
ETL_INTERNAL_TOKEN=globtrade-etl-dev
GLOBALTRADE_ETL_VIA_API=1
GLOBALTRADE_API_URL=http://localhost:8000

# Airflow (stack full)
AIRFLOW_SECRET_KEY=change-me-in-production
AIRFLOW_ADMIN_USER=globtrade_admin
AIRFLOW_ADMIN_PASSWORD=12345678
