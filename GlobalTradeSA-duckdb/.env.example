DUCKDB_PATH=db/globtrade.duckdb
PARQUET_PATH=data/ventas.parquet

# PocketBase (opcional — sync al arranque de la API)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
# true = al iniciar uvicorn: PocketBase → parquet → DuckDB (solo ventas nuevas por order_id)
POCKETBASE_SYNC_ON_STARTUP=false
